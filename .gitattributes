# .gitattributes -- Git line ending and binary file handling

# Line endings
*.rpy text eol=lf
*.py text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.txt text eol=lf
*.ini text eol=lf

# Binary files
*.rpyc binary
*.rpymc binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ogg binary
*.mp3 binary
*.wav binary
